# Copy to .env.local and fill in.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the app, used in e-mail links and short links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product name shown in the interface (provisional).
NEXT_PUBLIC_APP_NAME=Linkbio

# Stripe Connect (Dashboard → Developers → API keys). Server only.
STRIPE_SECRET_KEY=sk_test_
